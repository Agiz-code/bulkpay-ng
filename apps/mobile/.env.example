# Backend API URL
# For local development on Android Emulator/iOS Simulator:
#   Android: http://10.0.2.2:3000 (10.0.2.2 is the host machine IP from emulator)
#   iOS: http://localhost:3000
#
# For physical device testing:
#   Replace with your actual machine IP, e.g., http://192.168.1.100:3000
#
# For production:
#   Use your production backend URL, e.g., https://api.example.com
EXPO_PUBLIC_BACKEND_URL=http://localhost:3000
